{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rankly",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Weekly reports: every 5 minutes on Mondays (UTC), one brand per run,
  // until every active customer has this week's report.
  "triggers": { "crons": ["*/5 * * * 1"] },
  // Keep variables added in the Cloudflare dashboard (like the Supabase
  // URL/anon key) instead of wiping them on each deploy. Secrets are
  // always kept and never belong in this file.
  "keep_vars": true,
  // Non-secret settings, versioned with the code.
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_FALLBACK_MODELS": "gemini-3.5-flash-lite,gemini-3.1-flash-lite",
    "GEMINI_SEARCH": "off",
    "NEXT_PUBLIC_SITE_URL": "https://rankly.world",
    "EMAIL_FROM": "Rankly <reports@rankly.world>"
  }
}
