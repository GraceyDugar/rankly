# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model
GEMINI_MODEL=gemini-3.8-flash
# Set to "off" if your Gemini plan doesn't include Google Search grounding
GEMINI_SEARCH=on
# Tried in order when the main model is overloaded or out of daily quota
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Supabase: Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Any random string, used to hash visitor IPs for rate limiting
IP_HASH_SALT=

# Only this email can open /admin
ADMIN_EMAIL=

# Public site address (used for SEO, sitemap and links)
NEXT_PUBLIC_SITE_URL=https://rankly.world

# Resend: sends the weekly report emails
RESEND_API_KEY=
# Sender once rankly.world is verified in Resend, e.g. Rankly <reports@rankly.world>
EMAIL_FROM=
# Random string protecting /api/cron/weekly
CRON_SECRET=

# Dodo Payments
# "test" or "live" (must match the API key)
DODO_MODE=test
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID=
# "true" switches pricing buttons from early access to checkout
NEXT_PUBLIC_PAYMENTS_ENABLED=
